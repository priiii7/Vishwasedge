# Application
APP_NAME=VishwasEdge
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-me-in-production-32-char-minimum-please
API_KEY_HEADER=X-API-Key
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEFAULT_ADMIN_USERNAME=operator
DEFAULT_ADMIN_PASSWORD=changeme123
DEFAULT_API_KEY=dev-local-api-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/vishwasedge.db

# Cache (optional — falls back to in-memory LRU if unset/unreachable)
REDIS_URL=

# Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHROMA_PERSIST_DIR=./data/processed/chroma

# Adaptive LLM Router (AQR)
# Leave ANTHROPIC_API_KEY empty to run fully offline with the extractive fallback tier.
ANTHROPIC_API_KEY=
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_HEAVY_MODEL=claude-sonnet-5

# Edge Constraints
MAX_MEMORY_MB=4096
MAX_CPU_PERCENT=80
CACHE_SIZE_MB=512
OFFLINE_MODE=false

# Monitoring
ENABLE_METRICS=true
JAEGER_ENDPOINT=

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
