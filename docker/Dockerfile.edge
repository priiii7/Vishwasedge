# ARM64-optimized edge image, multi-stage build to keep the final image small.
#
# Build for both architectures with buildx (not run automatically by this
# build — requires Docker with buildx configured):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f docker/Dockerfile.edge -t vishwasedge:edge --push .

FROM python:3.11-slim AS builder
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --target=/deps -r requirements.txt

FROM python:3.11-slim
WORKDIR /app

RUN useradd --create-home --shell /bin/bash edgeuser \
    && mkdir -p /app/data/raw /app/data/processed \
    && chown -R edgeuser:edgeuser /app

COPY --from=builder /deps /usr/local/lib/python3.11/site-packages
COPY backend ./backend
COPY config ./config

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    OFFLINE_MODE=true \
    MAX_MEMORY_MB=4096

USER edgeuser
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
